{
	"name": "df_viajes_bronze",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "csv_bronze_viajes",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "sql_viajes",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "xls_bronce_viajes_2022",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "xls_bronce_viajes_2023",
						"type": "DatasetReference"
					},
					"name": "source4"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_sql_viajes",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "select1"
				},
				{
					"name": "union2"
				},
				{
					"name": "select2"
				},
				{
					"name": "union3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fec_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_reportados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source4",
				"source3, source4 union(byName: true)~> union1",
				"source1 select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fec_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          ValidacionesTarjeta = pasajeros_reportados,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje,",
				"          tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, select2 union(byName: true)~> union2",
				"union1 select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fecha_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          ValidacionesTarjeta = pasajeros_estimados,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje,",
				"          tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"union2, source2 union(byName: true)~> union3",
				"union3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}